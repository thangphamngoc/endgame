# Sao chép thành .env khi chạy local / deploy. Không có secret nào ở đây.
# Không commit file .env thật (đã có trong .gitignore).
PORT=3000
NODE_ENV=production

# ECONOMY_STUB=true: mọi "thanh toán thật" trong game chỉ là stub demo
# (không xử lý tiền thật). Xem docs/BRD.md §10. Không bao giờ đặt false
# nếu chưa có cổng thanh toán thật + phê duyệt của Sudo.
ECONOMY_STUB=true

# HOI_ADMIN_TOKEN: khóa GET /analytics khi mở public (P3-06, cycle 32).
# Đặt 1 chuỗi dài ngẫu nhiên, KHÔNG commit giá trị thật (.env đã trong
# .gitignore). Khi đặt: /analytics chỉ trả số liệu với ?token=... hoặc
# header Authorization: Bearer ...; sai/thiếu -> 403. Khi bỏ trống:
# /analytics mở như trước (mặc định dev local/QC) + server ghi 1 dòng
# cảnh báo analytics_unprotected lúc khởi động.
# HOI_ADMIN_TOKEN=doi-token-dai-ngau-nhien-o-day
